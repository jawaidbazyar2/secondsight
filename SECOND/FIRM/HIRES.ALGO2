    dec  b		; 4        dec  h		; 4        ld   c,l	; 4                ld   l,(IX+4)	; 14        ld   a,(bc)	; 6        or   (hl)       ; 6        ld   (de),a     ; 6	; 3        inc  de		; 4        dec  b		; 4        dec  h		; 4        ld   c,l	; 4                ld   l,(IX+5)	; 14        ld   a,(bc)	; 6        or   (hl)       ; 6        ld   (de),a     ; 6	; 4        inc  de		; 4        dec  b		; 4        dec  h		; 4        ld   c,l	; 4                ld   l,(IX+6)	; 14        ld   a,(bc)	; 6        or   (hl)       ; 6        ld   (de),a     ; 6	; 5        inc  de		; 4        dec  b		; 4        dec  h		; 4        ld   c,l	; 4        ld   l,(IX+7)	; 14        ld   a,(bc)	; 6        or   (hl)       ; 6        ld   (de),a     ; 6     ; 6        inc  de		; 4	        dec  b		; 4        dec  h		; 4        ld   c,l	; 4        ld   hl,8        add  hl,IX        push hl        pop  ix* loop 4 times.