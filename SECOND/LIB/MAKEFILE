#2/orcacdefs/vga.h: vga.h  cp vga.h 2/orcacdefs2/orcacdefs/vgalib.h: vgalib.h  cp vgalib.h 2/orcacdefso/vgalow.root: vgalow.asm vgalow.mac    compile vgalow.asm keep=o/vgalowo/vgalib.a: vgalib.c vgalib.h modes.h    compile vgalib.c keep=o/vgaliblvga: o/vgalow.root o/vgalib.a    rm -f lvga    makelib lvga +o/vgalow.root +o/vgalow.a    makelib lvga +o/vgalib.a    cp lvga 2/